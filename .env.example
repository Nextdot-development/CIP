# ---------------------------------------------------------------------------
# CIP — environment
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
# ---------------------------------------------------------------------------

# PostgreSQL connection for the application.
#
# IMPORTANT: this must be a NON-SUPERUSER role. PostgreSQL lets superusers and
# BYPASSRLS roles read straight through row-level security, so pointing this at
# Supabase's `postgres` role silently disables the second isolation layer.
# Migration 0003 creates a `cip_app` role for exactly this purpose.
# Visit /api/health to confirm RLS is actually binding for the role you used.
DATABASE_URL=postgres://cip_app:change-me@localhost:5432/cip

# Elevated connection used only by `npm run db:migrate` and `npm run db:seed`.
# Never used to serve a request. On Supabase this is the connection string from
# Project Settings -> Database.
DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5432/cip

# Password for the cip_app role that migration 0003 creates.
CIP_APP_DB_PASSWORD=change-me

# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase Storage — where Drive file bytes live.
#
# Leave these unset and the Drive writes to local disk under CIP_STORAGE_DIR
# instead, which is what `npm test` uses. Set them and the same code writes to
# a private Supabase bucket; nothing else changes.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security completely. It is
# server-only: never reference it from a client component. `npm run check:bundle`
# fails the build if it ever appears in client output.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cip-drive

# Where Drive bytes go when Supabase Storage is not configured.
CIP_STORAGE_DIR=./.storage
# Force local disk even when the Supabase variables are set (used by tests).
CIP_FORCE_LOCAL_STORAGE=false

# ---------------------------------------------------------------------------
# Embeddings (Phase 4)
#
# With no key the application uses a deterministic fake embedder, which is what
# the offline test suite runs against. Set a key and the same code calls OpenAI.
#
# PRIVACY: an embedding call sends chunk text to the provider. It sends nothing
# else — no file id, no company id, no path. See src/server/drive/embedding.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
CIP_EMBEDDING_MODEL=text-embedding-3-small
# Pin the fake embedder even when a key is present (used by tests).
CIP_FORCE_FAKE_EMBEDDER=false
# Cosine similarity below which a passage is not a result at all, overriding
# the OpenAI driver's default of 0.30. Leave unset unless you are calibrating
# it against real content: too high silently hides answers that exist.
CIP_MIN_RELEVANCE_SCORE=

# A database with pgvector for `npm run test:embeddings`. The embedded
# PostgreSQL used by `npm test` does not ship pgvector, so the Phase 4 suite
# skips unless this points somewhere that has it.
TEST_DATABASE_ADMIN_URL=

# ---------------------------------------------------------------------------
# Media generation (Phase Media)
#
# With no keys the application uses deterministic fake providers, which is what
# the offline test suite runs against. An unconfigured real provider refuses;
# it never returns a pretend result.
#
# PRIVACY: a generation sends the prompt — and, for an edit, the reference
# image bytes — to the selected provider. It sends nothing else: no company id,
# no storage path, no database id. Prompts and payloads are never logged.
# Treat prompts and reference images as company-confidential.
# ---------------------------------------------------------------------------

# Nano Banana 2 (gemini-3.1-flash-image), via the Gemini Interactions API.
# Either name works; GEMINI_API_KEY is what Google's own tooling reads.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
CIP_IMAGE_MODEL=gemini-3.1-flash-image

# Seedance 2.0, via fal's queue API — fal is the route ByteDance publishes for
# it, so this is a fal key. SEEDANCE_API_KEY is accepted as the same secret.
FAL_KEY=
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://queue.fal.run
SEEDANCE_MODEL=bytedance/seedance-2.0/text-to-video

# Pin the fake providers even when keys are present (used by tests).
CIP_FORCE_FAKE_PROVIDERS=false

# Generation rate limits. Capacity is the burst; refill is tokens per second.
# Defaults: images 5 then one per 12s, videos 2 then one a minute, and 20 per
# company then one every 6s across all its users.
CIP_IMAGE_RATE_CAPACITY=
CIP_IMAGE_RATE_REFILL_PER_SECOND=
CIP_VIDEO_RATE_CAPACITY=
CIP_VIDEO_RATE_REFILL_PER_SECOND=
CIP_COMPANY_RATE_CAPACITY=
CIP_COMPANY_RATE_REFILL_PER_SECOND=
