{
  "name": "cip",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx src/server/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx src/server/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "test": "node scripts/run-tests.mjs",
    "db:local": "node --env-file-if-exists=.env.local --import tsx scripts/local-db.ts",
    "prove": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/prove-isolation.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "prove:drive": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/prove-drive.ts",
    "storage:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate-storage.ts",
    "storage:gc": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/storage-gc.ts",
    "test:storage": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx --test --test-concurrency=1 tests/storage.test.ts",
    "db:rollback": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx src/server/migrate.ts --down",
    "drive:worker": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/drive-worker.ts",
    "test:embeddings": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx --test --test-concurrency=1 tests/embeddings.test.ts",
    "media:worker": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/media-worker.ts",
    "test:media": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/media.test.ts",
    "gdrive:worker": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/gdrive-sync-worker.ts",
    "test:gdrive": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/googleDrive.test.ts",
    "test:graph": "node --conditions=react-server --import tsx --test --test-concurrency=1 --test-force-exit tests/knowledgeGraph.test.ts",
    "brain:worker": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/brain-worker.ts",
    "cip:worker": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/cip-worker.ts",
    "test:brain": "node --conditions=react-server --import tsx --test --test-concurrency=1 --test-force-exit tests/brain.test.ts",
    "prove:brain": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/prove-brain.ts",
    "test:pdf": "node --conditions=react-server --import tsx --test --test-concurrency=1 --test-force-exit tests/pdfVisual.test.ts",
    "prove:pdf": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/prove-pdf.ts",
    "prove:mm-pdfs": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/prove-mm-pdfs.ts",
    "setup:radico": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/setup-radico.ts",
    "ingest": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/ingest-folder.ts",
    "unlearn": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/move-files.ts",
    "merge": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/merge-company.ts",
    "attribute": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/attribute-facts.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@napi-rs/canvas": "^1.0.8",
    "mammoth": "^1.12.2",
    "next": "^16.3.4",
    "pdfjs-dist": "^6.3.289",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "private": true
}
