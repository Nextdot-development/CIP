{
  "name": "cip",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx src/server/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx src/server/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:local": "node --env-file-if-exists=.env.local --import tsx scripts/local-db.ts",
    "prove": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/prove-isolation.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "prove:drive": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/prove-drive.ts",
    "storage:migrate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate-storage.ts",
    "storage:gc": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/storage-gc.ts",
    "test:storage": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx --test tests/storage.test.ts",
    "db:rollback": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx src/server/migrate.ts --down"
  },
  "dependencies": {
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "private": true
}
