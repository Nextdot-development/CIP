{
  "name": "cip",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/server/migrate.ts",
    "db:seed": "tsx src/server/seed.ts",
    "db:reset": "tsx src/server/migrate.ts && tsx src/server/seed.ts",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "private": true
}
